# 复制为 .env 后填写真实值(.env 已在 .gitignore 中,不会被提交)
APP_ENV=dev
# 被测服务
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8000
# 数据库(项目内默认用 SQLite;换 MySQL 只改这一行,代码不用动)
DATABASE_URL=sqlite:///./api_server.db
# MySQL 模板(把 <用户名> <密码> <库名> 换成真实值;密码里的 # @ : 等符号要 URL 编码,如 # → %23)
# DATABASE_URL=mysql+pymysql://<用户名>:<密码>@127.0.0.1:3306/<库名>?charset=utf8mb4
# 真实值请写进本地 .env(.gitignore 已排除),不要提交
# 仅本地开发用的占位密钥,生产必须替换
SECRET_KEY=change-me-in-real-env
# 测试账号(种子数据里的默认账号)
TEST_USERNAME=tester
TEST_PASSWORD=Passw0rd!
# 测试参数
HTTP_TIMEOUT=5
