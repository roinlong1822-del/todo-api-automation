# 复制为 .env 后填写真实值(.env 已在 .gitignore 中,不会被提交)
APP_ENV=dev
# 被测服务
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8000
# 数据库(项目内用 SQLite;换 MySQL 只改这一行)
DATABASE_URL=sqlite:///./api_server.db
# 仅本地开发用的占位密钥,生产必须替换
SECRET_KEY=change-me-in-real-env
# 测试账号(种子数据里的默认账号)
TEST_USERNAME=tester
TEST_PASSWORD=Passw0rd!
# 测试参数
HTTP_TIMEOUT=5
